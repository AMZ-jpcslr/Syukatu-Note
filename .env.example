NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Explicit local-only demo. Never set true for a real production database.
NEXT_PUBLIC_DEMO_MODE=false
# Used only by Drizzle CLI / seed; never exposed to the browser.
DATABASE_URL=

# Server-only monitoring credentials (never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
RECRUITMENT_MONITOR_ENABLED=false
# Optional Gemini fallback. Empty = free rule-only parsing.
GEMINI_API_KEY=
RECRUITMENT_AI_ENABLED=false
RECRUITMENT_GEMINI_MODEL=gemini-2.5-flash-lite
RECRUITMENT_AI_MONTHLY_LIMIT=50

# v2: Web origin and explicit extension allowlist (server-only).
APP_URL=https://syukatu-note.vercel.app
# Copy the actual ID from chrome://extensions, then redeploy Web.
EXTENSION_ORIGINS=
# Optional Gmail readonly OAuth. Leave all empty to disable Gmail.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# A distinct random 32-byte key encoded as base64; never NEXT_PUBLIC_.
GMAIL_TOKEN_ENCRYPTION_KEY=
